{
	"name": "@oh-my-pi/robomp",
	"version": "18.3.0",
	"private": true,
	"description": "Self-hosted GitHub triage/fix bot driving omp --mode rpc (TypeScript port)",
	"license": "MIT",
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"robomp": "./src/cli.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.ts' '{test,scripts}/**/*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.ts' '{test,scripts}/**/*.ts' '*.ts'",
		"serve": "bun src/cli.ts serve"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "catalog:",
		"@oh-my-pi/pi-coding-agent": "catalog:",
		"@oh-my-pi/pi-natives": "catalog:",
		"@oh-my-pi/pi-tui": "catalog:",
		"@oh-my-pi/pi-utils": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
